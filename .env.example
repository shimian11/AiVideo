# Agnes Studio 环境变量示例
# DATABASE_URL 放 .env（Prisma CLI 只读 .env），其余放 .env.local

# 数据库（PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/agnes_db?schema=public

# Auth.js
NEXTAUTH_SECRET=用 openssl rand -base64 32 生成
NEXTAUTH_URL=http://localhost:3000

# 用户 API Key 加密密钥（32 字节，base64）- 本地与生产必须一致！
# 生成: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Agnes 网关（可选）
AGNES_BASE_URL=https://apihub.agnes-ai.com

# next-auth 信任 Host（自部署需开启，否则登录报 UntrustedHost）
AUTH_TRUST_HOST=true

# 系统默认 Agnes API Key（新用户注册自动配备一个系统默认 Key，用户可添加自己的 Key 选用替代）
AGNES_DEFAULT_API_KEY=
