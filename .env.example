# Agnes Studio 环境变量示例
# 复制为 .env.local 并填入真实值；DATABASE_URL 放 .env（Prisma CLI 只读 .env）

# 数据库（PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/agnes_db?schema=public

# Auth.js
NEXTAUTH_SECRET=用 openssl rand -base64 32 生成
NEXTAUTH_URL=http://localhost:3000

# Agnes API（本阶段生成仍用 env Key，后续改为每用户自己的 Key）
AGNES_API_KEY=your_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com
